# AWS Bedrock Credentials & Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1

# Optional: AWS Session Token (for temporary STS credentials or AWS SSO)
# AWS_SESSION_TOKEN=your_aws_session_token_here

# Bedrock Model Configuration (e.g. Qwen3, Claude 3.5 Sonnet, Claude 3 Haiku)
BEDROCK_MODEL_ID=qwen.qwen3-next-80b-a3b
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Legacy Gemini API Key (if fallback is needed)
# GEMINI_API_KEY=your_gemini_api_key_here
